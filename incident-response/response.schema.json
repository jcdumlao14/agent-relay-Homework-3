{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Relay Incident Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "summary",
    "observed_impact",
    "evidence_refs",
    "probable_causes",
    "proposed_actions",
    "confidence",
    "requested_action",
    "rationale",
    "escalation"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "pattern": "^INC-[0-9]{8}-[A-Z0-9-]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "observed_impact": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probable_causes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "observe",
        "verify",
        "escalate",
        "rollback"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "escalation": {
      "type": "boolean"
    }
  }
}
